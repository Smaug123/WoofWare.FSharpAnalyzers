<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <IsPackable>false</IsPackable>
      <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Assembly.fs" />
        <Compile Include="ProjectOptions.fs" />
        <Compile Include="Tests.fs" />
        <Compile Include="FlagFactsTests.fs" />
        <Compile Include="Utils.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Analyzers.SDK.Testing" Version="0.39.0" />
        <PackageReference Include="FsUnit" Version="7.1.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0"/>
        <PackageReference Include="NUnit" Version="4.6.1"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0"/>
        <PackageReference Include="WoofWare.Expect" Version="0.8.7" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="Data\**\*.fs" />
      <EmbeddedResource Include="Data\**\*.fs" />
      <EmbeddedResource Include="Data\**\*.fs.expected" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\WoofWare.FSharpAnalyzers\WoofWare.FSharpAnalyzers.fsproj" />
    </ItemGroup>

</Project>
